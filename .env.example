# Copy this file to .env.local for local development.
# Never commit .env.local or any file with real values.
# Set all of these in the Vercel dashboard under Project > Settings > Environment Variables.

# ── Sanity (content: articles, authors, taxonomy) ──────────────────────────────
# From sanity.io/manage (or `npx sanity init` output).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-12

# Same project ID/dataset as above, but under the SANITY_STUDIO_ prefix —
# required separately because `sanity.config.ts`/`sanity.cli.ts` run through
# Sanity's own Vite-based tooling, which only exposes SANITY_STUDIO_-prefixed
# vars (like Next only exposes NEXT_PUBLIC_-prefixed ones).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Server-side only — never NEXT_PUBLIC_. Viewer-scope token from
# sanity.io/manage → project → API → Tokens. The app reads content with
# this rather than relying on anonymous/public dataset access.
SANITY_API_READ_TOKEN=

# Verifies POST requests to /api/revalidate actually came from the Sanity
# webhook (Studio → API → Webhooks). Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# Editor-scope token from sanity.io/manage → project → API → Tokens.
# Local-only, used once by `npx tsx scripts/migrate-to-sanity.ts` to seed
# content — not read by the deployed app. Safe to revoke after migrating.
SANITY_API_WRITE_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Secret key: server-side only. NEVER prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Publishable key: safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret: used to verify incoming Stripe webhook requests.
# Generate with: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=

# ── Auth (add when implementing login) ────────────────────────────────────────
# Example: NextAuth secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
