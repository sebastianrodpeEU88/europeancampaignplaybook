# Copy this file to .env.local for local development.
# Never commit .env.local or any file with real values.
# Set all of these in the Vercel dashboard under Project > Settings > Environment Variables.

# ── Sanity (content: articles, authors, taxonomy) ──────────────────────────────
# From sanity.io/manage (or `npx sanity init` output).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-12

# Same project ID/dataset as above, but under the SANITY_STUDIO_ prefix —
# required separately because `sanity.config.ts`/`sanity.cli.ts` run through
# Sanity's own Vite-based tooling, which only exposes SANITY_STUDIO_-prefixed
# vars (like Next only exposes NEXT_PUBLIC_-prefixed ones).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Server-side only — never NEXT_PUBLIC_. Viewer-scope token from
# sanity.io/manage → project → API → Tokens. The app reads content with
# this rather than relying on anonymous/public dataset access.
SANITY_API_READ_TOKEN=

# Verifies POST requests to /api/revalidate actually came from the Sanity
# webhook (Studio → API → Webhooks). Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# Editor-scope token from sanity.io/manage → project → API → Tokens.
# Local-only, used once by `npx tsx scripts/migrate-to-sanity.ts` to seed
# content — not read by the deployed app. Safe to revoke after migrating.
SANITY_API_WRITE_TOKEN=

# ── Supabase (auth + membership/subscription status) ────────────────────────────
# From your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never NEXT_PUBLIC_. Bypasses Row Level Security; used
# by the Stripe webhook handler to write subscription status, and by
# scripts/purge-bot-signups.mjs to clean up unconfirmed spam accounts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (signup/login CAPTCHA — anti-bot) ──────────────────────
# Blocks automated signup/login spam. Two-sided setup, turn on together:
#   1. Create a widget at dash.cloudflare.com → Turnstile. Put the SITE key here.
#   2. Put the SECRET key in Supabase → Authentication → Attack Protection →
#      enable CAPTCHA, provider "Turnstile". Supabase verifies the token.
# Until the site key is set, the widget doesn't render and auth works as before.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Secret key: server-side only. NEVER prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Webhook signing secret from Stripe → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=

# Price IDs from Stripe → Product catalog (see supabase/schema.sql and
# src/lib/stripe.ts for how these map to tiers). Six total: one product per
# tier, one price each for monthly and annual billing.
STRIPE_PRICE_STUDENT_MONTHLY=
STRIPE_PRICE_STUDENT_ANNUAL=
STRIPE_PRICE_YOUNG_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_YOUNG_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sends event registration confirmations (with the .ics attached). Registration
# works without this — email just no-ops until RESEND_API_KEY is set.
# From resend.com → API Keys. The From address must be on a domain verified in
# Resend (e.g. the updates.campaignplaybook.eu subdomain); reply-to can be any
# address. Defaults live in src/lib/email.ts if the *_FROM/*_REPLY_TO are unset.
RESEND_API_KEY=
EMAIL_FROM=European Campaign Playbook <events@updates.campaignplaybook.eu>
EMAIL_REPLY_TO=sebastian@campaignplaybook.eu

# Event reminder cron (vercel.json → /api/cron/event-reminders). Set CRON_SECRET
# to any random string; Vercel then sends it as a Bearer token so only the cron
# can trigger reminders. REMINDER_WINDOW_HOURS controls how far ahead to remind
# (default 48 — suits a daily cron so everyone gets ≥~24h notice; set to 24 if
# you run the job hourly for precise 24h reminders).
CRON_SECRET=
REMINDER_WINDOW_HOURS=48

# ── Monitoring (Sentry) ───────────────────────────────────────────────────────
# Optional — server and client error reporting no-op until these are set
# (see src/instrumentation.ts, src/instrumentation-client.ts). Create a
# project at sentry.io, then Settings → Client Keys (DSN) for the value.
# Server-side errors (route handlers, Server Actions, Server Components).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Browser-side errors. Same DSN value as above is fine (one Sentry project
# can receive both), just under the NEXT_PUBLIC_ prefix so the client bundle
# can read it.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
